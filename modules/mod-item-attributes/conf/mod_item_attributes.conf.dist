#
# 物品属性模块配置
#

[worldserver]

###################################################################################################
#
#    ItemAttributes.Enable
#        描述: 启用物品属性模块
#        默认: 1 - 启用
#               0 - 禁用
#

ItemAttributes.Enable = 1

###################################################################################################
#
#    ItemAttributes.Announce
#        描述: 在服务器启动时显示模块加载信息
#        状态: 【预留功能】当前版本未实现，保留供后续扩展
#        默认: 1 - 启用
#               0 - 禁用
#

ItemAttributes.Announce = 1

###################################################################################################
#
#    ItemAttributes.LoginMessage
#        描述: 在玩家登录时显示模块加载信息
#        默认: 0 - 禁用
#               1 - 启用
#

ItemAttributes.LoginMessage = 0

###################################################################################################
#
#    ItemAttributes.AutoGenerateOnLoot
#        描述: 在玩家获得物品时自动生成物品属性
#        状态: 【预留功能】当前版本未实现，保留供后续扩展
#        默认: 0 - 禁用
#               1 - 启用
#

ItemAttributes.AutoGenerateOnLoot = 0

###################################################################################################
#
#    ItemAttributes.AutoGenerateMethod
#        描述: 自动生成物品属性的方法
#        状态: 【预留功能】当前版本未实现，保留供后续扩展
#        默认: 1 - 根据物品等级
#               2 - 根据物品品质
#               3 - 随机生成
#

ItemAttributes.AutoGenerateMethod = 1

###################################################################################################
#
#    ItemAttributes.ShowInTooltip
#        描述: 在物品提示信息中显示物品属性
#        状态: 【预留功能】当前版本未实现，保留供后续扩展
#        默认: 1 - 启用
#               0 - 禁用
#

ItemAttributes.ShowInTooltip = 1

###################################################################################################
#
#    ItemAttributes.ApplyOnEquip
#        描述: 在装备物品时应用物品属性效果
#        状态: 【预留功能】当前版本未实现，保留供后续扩展
#        默认: 1 - 启用
#               0 - 禁用
#

ItemAttributes.ApplyOnEquip = 1

###################################################################################################
#
#    ItemAttributes.ForceRefreshOnLogin
#        描述: 玩家登录时强制刷新装备属性
#        说明: 默认情况下，OnPlayerEquip 已为每个装备应用属性，
#              幻境系统会在登录最后统一刷新，不需要重复刷新
#        默认: 0 - 禁用（推荐，性能更好）
#               1 - 启用（强制刷新）
#

ItemAttributes.ForceRefreshOnLogin = 0

###################################################################################################
#
#    ItemAttributes.Debug.Performance
#        描述: 启用物品属性系统性能调试日志
#        说明: 输出加载时间、装备应用时间等性能指标
#        默认: 0 - 禁用
#               1 - 启用
#

ItemAttributes.Debug.Performance = 0
