#######################################
# 物品技能系统配置
#######################################
[worldserver]

###################################
# 基本设置
###################################

# 启用物品技能系统
# 默认: 1 (启用)
# 设置为 0 禁用
ItemSkills.Enable = 1

# 物品技能系统日志级别
# 0 - 禁用日志
# 1 - 仅错误日志
# 2 - 错误和基本信息
# 3 - 详细日志（包括调试信息）
# 默认: 2
ItemSkills.LogLevel = 2

###################################
# 技能设置
###################################

# 物品技能随机几率修正
# 默认: 1.0 (100%)
# 设置为 0.5 表示所有几率减半
ItemSkills.ChanceModifier = 1.0

# 物品技能冷却时间修正
# 默认: 1.0 (100%)
# 设置为 0.5 表示所有冷却时间减半
ItemSkills.CooldownModifier = 1.0

# 物品技能触发频率修正
# 默认: 1.0 (100%)
# 设置为 2.0 表示触发频率翻倍
ItemSkills.PPMModifier = 1.0

###################################
# 击中触发限流设置（防止服务器卡死）
###################################

# 每次伤害最多触发几个击中技能
# 默认: 5
# 如果玩家装备了很多击中触发技能，每次攻击最多只触发这个数量
ItemSkills.MaxTriggersPerDamage = 5

# 击中触发全局冷却（毫秒）
# 默认: 500 (0.5秒)
# 两次击中触发之间的最小间隔时间
ItemSkills.GlobalTriggerCooldown = 500

# 调试：压制物品技能触发时的客户端反馈包
# 默认: 0 (关闭)
Debug.SuppressPlayerProcClientFeedback = 0

# 调试：压制反馈统计日志间隔（毫秒）
# 默认: 1000
Debug.SuppressPlayerProcClientFeedback.LogIntervalMs = 1000

# 物品技能使用次数修正
# 默认: 1.0 (100%)
# 设置为 2.0 表示使用次数翻倍
ItemSkills.ChargesModifier = 1.0

# 启用随机技能生成
# 默认: 1 (启用)
# 设置为 0 禁用
ItemSkills.EnableRandomGeneration = 1

###################################
# 命令设置
###################################

# 允许玩家使用物品技能命令
# 默认: 1 (启用)
# 设置为 0 禁用
ItemSkills.AllowPlayerCommands = 1

# 物品技能命令所需的最低GM等级
# 默认: 1
ItemSkills.MinGMRankForCommands = 1
