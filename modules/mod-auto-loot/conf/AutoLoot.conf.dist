[worldserver]

###################################################################################################
#  自动拾取模块
###################################################################################################

# 启用自动拾取功能
# 注意：账号还需要在角色库 `_授权自动拾取` 表中配置 `自动拾取=1` 才能生效
# 默认: 1 (启用)
# 设置为0禁用
AutoLoot.Enable = 1

# 自动拾取金币
# 默认: 1 (启用)
# 设置为0禁用
AutoLoot.Money = 1

# 自动拾取任务物品
# 默认: 1 (启用)
# 设置为0禁用
AutoLoot.QuestItems = 1

# 自动拾取调试信息
# 默认: 0 (禁用)
# 设置为1启用
AutoLoot.Debug = 0
