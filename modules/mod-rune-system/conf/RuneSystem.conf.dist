# 符文系统配置文件

[worldserver]

###################################################################################################
#   符文系统配置
###################################################################################################

# 启用符文系统
# 默认: 1 (启用)
# 设置为 0 禁用
RuneSystem.Enable = 1

# 符文触发几率系数
# 符文触发几率 = 基础触发几率 * 此系数
# 默认: 1.0
RuneSystem.ProcChanceFactor = 1.0

# 符文冷却时间系数
# 符文冷却时间 = 基础冷却时间 * 此系数
# 默认: 1.0
RuneSystem.CooldownFactor = 1.0

# 调试模式
# 启用后会输出详细的调试日志
# 默认: 0 (关闭)
RuneSystem.DebugMode = 0
