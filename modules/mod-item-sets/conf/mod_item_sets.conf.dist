[物品套装]
# 启用物品套装系统
# 默认: 1 (启用)
# 设置为0禁用整个模块
物品套装.启用 = 1

# 调试模式
# 默认: 0 (禁用)
# 设置为1启用调试日志
物品套装.调试模式 = 0

# 允许部分套装加成
# 如果设置为1，即使没有集齐全套，也会根据已装备数量获得相应加成
# 默认: 1 (启用)
物品套装.允许部分加成 = 1

# 每个玩家最多可以激活的套装数量
# 默认: 10
物品套装.最大套装数 = 10

# 套装效果提示
# 当玩家装备套装物品时，是否显示套装效果提示
# 默认: 0 (禁用) - 关闭套装效果激活、获得/失去光环等提示信息
物品套装.显示效果提示 = 0

# 套装图标显示
# 是否在物品图标上显示套装标记
# 默认: 1 (启用)
物品套装.显示套装标记 = 1
